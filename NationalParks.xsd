<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema for a directory of National Parks -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

	<!-- Root element: contains one or more NationalPark elements -->
	<xs:element name="NationalParks">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="NationalPark" type="NationalParkType" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<!-- One park: Name, then one or more Phone, then Address  -->
	<xs:complexType name="NationalParkType">
		<xs:sequence>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="Phone" type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
			<xs:element name="Address" type="AddressType"/>
		</xs:sequence>
		<!-- Optional attribute: a park may or may not have a rating -->
		<xs:attribute name="Rating" type="xs:decimal" use="optional"/>
	</xs:complexType>

	<!-- Address: five child elements in order, plus a required NearestAirport attribute -->
	<xs:complexType name="AddressType">
		<xs:sequence>
			<xs:element name="Number" type="xs:string"/>
			<xs:element name="Street" type="xs:string"/>
			<xs:element name="City" type="xs:string"/>
			<xs:element name="State" type="xs:string"/>
			<xs:element name="Zip" type="xs:string"/>
		</xs:sequence>
		<!-- Required attribute: every address must name its nearest airport -->
		<xs:attribute name="NearestAirport" type="xs:string" use="required"/>
	</xs:complexType>
</xs:schema>
